    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[0]
      value: 'Next, the PASS technique for using fire extinguishers safely:'
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[1]
      value: 'P - PULL: Pull the safety pin from the fire extinguisher.'
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[2]
      value: 'A - AIM: Aim the nozzle at the BASE of the flames,'
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[3]
      value: not at the top. Target the fuel source, not the smoke.
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[4]
      value: 'S - SQUEEZE: Squeeze the handle to release the'
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[5]
      value: extinguishing agent in controlled bursts.
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[6]
      value: 'S - SWEEP: Sweep the nozzle side to side at the base'
      objectReference: {fileID: 0}
    - target: {fileID: 2091064551252122857, guid: 684f8a90a2fe4a344aaa840496e61092, type: 3}
      propertyPath: mediaTriggers.Array.data[14].dialogueLines.Array.data[7]
      value: of the fire until it appears to be completely out.
      objectReference: {fileID: 0}
